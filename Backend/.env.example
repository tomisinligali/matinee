# Server Configuration
PORT=4000
HOST=0.0.0.0
APP_URL="http://localhost:4000"

# PostgreSQL Database URL
DATABASE_URL="postgresql://username:password@localhost:5432/matinee_dev?schema=public"

# Authentication Token Secret
JWT_SECRET="replace_with_a_secure_random_secret"
JWT_EXPIRES_IN="7d"

# TMDB API Key (The Movie Database)
TMDB_API_KEY="your_tmdb_api_key_here"

# Redis Cache URL
REDIS_URL="redis://localhost:6379"

# Flutterwave Payment Provider Configuration (Test Mode)
FLUTTERWAVE_PUBLIC_KEY="FLWPUBK_TEST-your_public_key_here"
FLUTTERWAVE_SECRET_KEY="FLWSECK_TEST-your_secret_key_here"
FLUTTERWAVE_SECRET_HASH="matinee_webhook_secret_hash_dev"
FLUTTERWAVE_BASE_URL="https://api.flutterwave.com/v3"

# Email Configuration
# Free default: 'nodemailer' (works automatically via free Ethereal sandbox or custom SMTP)
# Production upgrade: 'resend' (activates when RESEND_API_KEY is supplied)
EMAIL_PROVIDER="nodemailer"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="\"Matinee Cinema\" <noreply@matinee.app>"

# Resend API Configuration (when ready to upgrade from Nodemailer)
RESEND_API_KEY=""
