datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  name         String?
  firstName    String?       @map("first_name")
  middleName   String?       @map("middle_name")
  lastName     String?       @map("last_name")
  passwordHash String        @map("password_hash")
  role         String        @default("CUSTOMER")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  bookings     Booking[]
  seatHolds    SeatHold[]

  @@map("users")
}

model Cinema {
  id        String   @id @default(uuid())
  name      String
  location  String
  status    String   @default("ACTIVE") // ACTIVE | SUSPENDED
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  screens   Screen[]

  @@map("cinemas")
}

model Screen {
  id        String     @id @default(uuid())
  cinemaId  String     @map("cinema_id")
  name      String
  capacity  Int
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  cinema    Cinema     @relation(fields: [cinemaId], references: [id], onDelete: Cascade)
  seats     Seat[]
  showtimes Showtime[]

  @@map("screens")
}

model Seat {
  id        String   @id @default(uuid())
  screenId  String   @map("screen_id")
  row       String
  col       Int
  seatLabel String   @map("seat_label")
  seatType  String   @default("STANDARD") @map("seat_type") // STANDARD | WHEELCHAIR

  screen    Screen   @relation(fields: [screenId], references: [id], onDelete: Cascade)
  holds     SeatHold[]
  bookingSeats BookingSeat[]

  @@unique([screenId, seatLabel])
  @@map("seats")
}

model Movie {
  id             String     @id @default(uuid())
  tmdbId         Int?       @unique @map("tmdb_id")
  title          String
  overview       String?
  posterPath     String?    @map("poster_path")
  runtimeMinutes Int?       @map("runtime_minutes")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  showtimes      Showtime[]

  @@map("movies")
}

model Showtime {
  id          String     @id @default(uuid())
  screenId    String     @map("screen_id")
  movieId     String     @map("movie_id")
  startTime   DateTime   @map("start_time")
  endTime     DateTime   @map("end_time")
  priceMinor  Int        @map("price_minor") // Stored in minor integer units (kobo)
  currency    String     @default("NGN")
  status      String     @default("SCHEDULED") // SCHEDULED | CANCELLED | COMPLETED
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  screen      Screen     @relation(fields: [screenId], references: [id], onDelete: Restrict)
  movie       Movie      @relation(fields: [movieId], references: [id], onDelete: Restrict)
  holds       SeatHold[]
  bookings    Booking[]

  @@map("showtimes")
}

model SeatHold {
  id          String   @id @default(uuid())
  showtimeId  String   @map("showtime_id")
  seatId      String   @map("seat_id")
  userId      String   @map("user_id")
  status      String   @default("HELD") // HELD | RELEASED | CONVERTED
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  showtime    Showtime @relation(fields: [showtimeId], references: [id], onDelete: Cascade)
  seat        Seat     @relation(fields: [seatId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([showtimeId, seatId, status])
  @@map("seat_holds")
}

model Booking {
  id              String          @id @default(uuid())
  userId          String          @map("user_id")
  showtimeId      String          @map("showtime_id")
  bookingRef      String          @unique @map("booking_ref")
  status          String          @default("PENDING_PAYMENT") // PENDING_PAYMENT | CONFIRMED | CANCELLED | REFUNDED
  subtotalMinor   Int             @map("subtotal_minor") // Integer minor units (kobo)
  serviceFeeMinor Int             @map("service_fee_minor") // Calculated on server
  totalMinor      Int             @map("total_minor") // Subtotal + Service Fee
  currency        String          @default("NGN")
  idempotencyKey  String          @unique @map("idempotency_key")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  user            User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  showtime        Showtime        @relation(fields: [showtimeId], references: [id], onDelete: Restrict)
  seats           BookingSeat[]
  paymentAttempts PaymentAttempt[]
  tickets         Ticket[]
  refunds         RefundRecord[]

  @@map("bookings")
}

model BookingSeat {
  id         String   @id @default(uuid())
  bookingId  String   @map("booking_id")
  showtimeId String   @map("showtime_id")
  seatId     String   @map("seat_id")
  seatLabel  String   @map("seat_label")
  priceMinor Int      @map("price_minor")

  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  seat       Seat     @relation(fields: [seatId], references: [id], onDelete: Restrict)

  @@unique([bookingId, seatId])
  @@unique([showtimeId, seatId])
  @@map("booking_seats")
}

model PaymentAttempt {
  id            String         @id @default(uuid())
  bookingId     String         @map("booking_id")
  txRef         String         @unique @map("tx_ref")
  provider      String         @default("FLUTTERWAVE")
  providerTxId  String?        @map("provider_tx_id")
  amountMinor   Int            @map("amount_minor")
  currency      String         @default("NGN")
  status        String         @default("INITIATED") // INITIATED | SUCCEEDED | FAILED | ABANDONED
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  booking       Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  refunds       RefundRecord[]

  @@map("payment_attempts")
}

model WebhookEvent {
  id        String   @id @default(uuid())
  provider  String   @default("FLUTTERWAVE")
  eventId   String   @map("event_id")
  eventType String   @map("event_type")
  payload   String   @db.Text
  status    String   @default("PROCESSED") // PROCESSED | FAILED
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([provider, eventId])
  @@map("webhook_events")
}

model RefundRecord {
  id               String          @id @default(uuid())
  bookingId        String          @map("booking_id")
  paymentAttemptId String?         @map("payment_attempt_id")
  amountMinor      Int             @map("amount_minor")
  currency         String          @default("NGN")
  reason           String          // SHOWTIME_CANCELLED | LATE_PAYMENT_RECOVERY
  status           String          @default("COMPLETED") // PENDING | COMPLETED | FAILED
  txRef            String          @map("tx_ref")
  providerRefundId String?         @map("provider_refund_id")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  booking          Booking         @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  paymentAttempt   PaymentAttempt? @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)

  @@map("refund_records")
}

model Ticket {
  id         String   @id @default(uuid())
  bookingId  String   @map("booking_id")
  seatLabel  String   @map("seat_label")
  ticketCode String   @unique @map("ticket_code")
  qrPayload  String   @map("qr_payload") @db.Text
  status     String   @default("VALID") // VALID | USED | CANCELLED
  createdAt  DateTime @default(now()) @map("created_at")

  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("tickets")
}

model BackgroundJob {
  id             String    @id @default(uuid())
  queueName      String    @map("queue_name")
  jobType        String    @map("job_type")
  payload        String    @db.Text
  status         String    @default("PENDING") // PENDING | PROCESSING | COMPLETED | FAILED | DEAD_LETTER
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5) @map("max_attempts")
  backoffSeconds Int       @default(10) @map("backoff_seconds")
  lockedBy       String?   @map("locked_by")
  lockedAt       DateTime? @map("locked_at")
  runAt          DateTime  @default(now()) @map("run_at")
  lastError      String?   @map("last_error") @db.Text
  correlationId  String?   @map("correlation_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([queueName, status, runAt])
  @@map("background_jobs")
}

